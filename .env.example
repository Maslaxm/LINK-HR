# LINK HR - Firebase Web App configuration
# Firebase Console > Project settings > General > Your apps > SDK setup and configuration.
#
# Local development:
#   Copy this file to .env.local and fill in the values.
#
# Netlify:
#   Add every variable below in Site configuration > Environment variables.
#   Do not upload or commit .env.local; Netlify builds read the site environment.
#   Firebase web configuration is public client configuration, not a server secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Emulator suite (local development only; never enable for Netlify production)
VITE_USE_EMULATORS=false
VITE_EMULATOR_HOST=127.0.0.1
